{
  "name": "@jqhtml/vscode-extension",
  "displayName": "JQHTML",
  "description": "Syntax highlighting and language support for JQHTML template files",
  "version": "2.3.68",
  "publisher": "jqhtml",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "vscode:prepublish": "echo Skipping prepublish",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node tools/test-all.js",
    "test:unit": "node tools/test-formatter.js && node tools/test-providers.js",
    "test:grammar": "node tools/test-grammar.js",
    "test:host": "node tools/test-extension-host/run.js",
    "build": "./build.sh",
    "compile:release": "tsc -p ./tsconfig.release.json",
    "build:dev": "./build.sh --dev",
    "format": "node tools/format-cli.js"
  },
  "files": [
    "out",
    "syntaxes",
    "snippets",
    "language-configuration.json",
    "blade-language-configuration.json",
    ".version",
    "README.md",
    "LLM_REFERENCE.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "jqhtml",
    "jquery",
    "template",
    "component",
    "html"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jqhtml/jqhtml-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/jqhtml/jqhtml-vscode/issues"
  },
  "activationEvents": [
    "onLanguage:jqhtml",
    "onLanguage:blade",
    "onLanguage:php"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jqhtml",
        "aliases": [
          "JQHTML",
          "jqhtml"
        ],
        "extensions": [
          ".jqhtml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "blade",
        "configuration": "./blade-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jqhtml",
        "scopeName": "source.jqhtml",
        "path": "./syntaxes/jqhtml.tmLanguage.json"
      },
      {
        "scopeName": "source.jqhtml.blade-injection",
        "path": "./syntaxes/blade-jqhtml.tmLanguage.json",
        "injectTo": [
          "text.blade",
          "text.html.php"
        ]
      }
    ],
    "snippets": [
      {
        "language": "jqhtml",
        "path": "./snippets/jqhtml.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/jqhtml-component.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/jqhtml-component.json"
      }
    ],
    "configurationDefaults": {
      "[jqhtml]": {
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        }
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "jqhtmlTagAttribute": "#FFA500"
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "jqhtmlTagAttribute",
        "superType": "parameter",
        "description": "The tag attribute on jqhtml components"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "jqhtmlTagAttribute": [
            "entity.other.attribute-name.jqhtml.tag"
          ]
        }
      }
    ],
    "configuration": {
      "title": "JQHTML",
      "properties": {
        "jqhtml.enableBladeSupport": {
          "type": "boolean",
          "default": true,
          "description": "Enable JQHTML component highlighting in Laravel Blade (.blade.php) files"
        },
        "jqhtml.enableBladeAutoSpacing": {
          "type": "boolean",
          "default": true,
          "description": "Automatically add spaces inside Blade tags when typing ({{ -> {{ | }})"
        },
        "jqhtml.bladeIndentationRules": {
          "type": "boolean",
          "default": true,
          "description": "Apply JQHTML's indentation rules and word pattern to Blade files. This overrides the Blade extension's indentation rules for every Blade file in the window; set false if you use another Blade extension's rules."
        },
        "jqhtml.debug": {
          "type": "boolean",
          "default": false,
          "description": "Write verbose diagnostics to the JQHTML output channel"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.8.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "author": "jqhtml",
  "homepage": "https://jqhtml.org/",
  "dependencies": null
}
